# preview's settings. Copy to .env, fill in, chmod 600, and keep each value in the password manager too.
# A commented line keeps the image's default; uncomment it only to change that.

# The public URL of the app: links in sign-in mails and MCP results, and the issuer of MCP tokens. Required.
PUBLIC_URL=https://preview.example.com

# 32 or more random characters that sign sessions and tokens (openssl rand -base64 48). Required.
PREVIEW_SECRET=

# Who may sign in: addresses and @domain entries, comma-separated. Empty: nobody.
PREVIEW_ALLOWED_EMAILS=you@example.org

# Sign-in by email: a code (and a link) mailed through this SMTP server.
PREVIEW_SMTP_URL=smtps://user:password@smtp.example.org:465
PREVIEW_SMTP_FROM=Preview <noreply@example.com>
# off: no sign-in by mail although SMTP is set (it then sends only the feedback mail); a provider below must remain.
# PREVIEW_SIGNIN_EMAIL=off

# Print figures (time, weight, grams per filament) for a 3MF that Bambu Studio has not sliced: this slicing service's POST /estimate is
# asked, one file at a time. Unset: such files show no figures. The token lifts the service's hourly limit; the material is what a file
# is sliced in when its own filaments are neither PLA nor PETG.
# PREVIEW_SLICER_URL=https://slicing.example.com
# PREVIEW_SLICER_TOKEN=
# PREVIEW_SLICER_MATERIAL=PLA

# Where a customer's feedback (a comment and colour wishes) is mailed, through the SMTP server above. Unset: no mail; the web app shows
# the feedback either way.
# PREVIEW_FEEDBACK_EMAIL=feedback@example.com

# Sign-in providers besides the mail (next-app-kit): GITHUB, GOOGLE and APPLE are built in; any other OIDC provider needs its issuer.
# A block is valid only when complete, so it stays commented out until it is filled in.
# PREVIEW_OIDC_GITHUB_CLIENT_ID=
# PREVIEW_OIDC_GITHUB_CLIENT_SECRET=
# Any other provider, <NAME> its name in capitals (the button's name unless _LABEL is set):
# PREVIEW_OIDC_<NAME>_CLIENT_ID=
# PREVIEW_OIDC_<NAME>_CLIENT_SECRET=
# PREVIEW_OIDC_<NAME>_ISSUER=https://id.example.org/application/o/preview
# PREVIEW_OIDC_<NAME>_LABEL=

# Who runs this instance, as every page shows it. The product names no one by itself: these are yours.
# The name in the header and the page title. Default: Preview
PREVIEW_BRAND_NAME=
# Where the header's name links to, such as your website. Default: no link
PREVIEW_BRAND_URL=
# The accent colour, as hex (#1d4ed8 or #15c); it must stay readable as text on white (WCAG AA, 4.5:1). Default: #1d4ed8
PREVIEW_ACCENT_COLOR=
# Your logo for the header: an .svg or .png file inside DATA_DIR, as a path relative to it. Default: none, the name alone
PREVIEW_LOGO=
# The footer's links to your imprint and privacy policy, on every page (operators in Germany need both). Default: none
PREVIEW_IMPRINT_URL=
PREVIEW_PRIVACY_URL=

# The largest upload a request may send, in megabytes (a version's 3MF, its preview and its drawings together); a larger one is
# refused with 413. Default: 100
# PREVIEW_MAX_UPLOAD_MB=100

# Where preview.sqlite, auth.sqlite and the uploaded files live. Default in the image: /data
# DATA_DIR=/data

# The port the server listens on; it must be the real one, since /mcp and /api/v1 check tokens against the app's own key set at
# http://127.0.0.1:$PORT. Default in the image: 3000
# PORT=3000

# The time zone of the log's and the app's dates. Default: UTC
# TZ=Europe/Berlin

# A fixed person instead of signing in, for development. Refused when NODE_ENV=production, as in the image.
# PREVIEW_DEV_USER=you@example.org

# The log's level: debug, info, warn, error or silent. Default: info
# PREVIEW_LOG_LEVEL=info

# The owner of /data inside the container. Default: the owner of the mounted folder (1000 if that is root)
# PUID=1000
# PGID=1000

# A file of extra CA certificates (PEM) to trust besides the image's, e.g. an internal SMTP server's; mount the file into the container.
# NODE_EXTRA_CA_CERTS=/certs/internal-ca.pem

# 1 turns on the end-to-end tests' sign-in route (anyone on the allowlist signs in without a mail). Outside production only; never on a
# server.
# PREVIEW_E2E=1
